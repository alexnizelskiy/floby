# ── floby: переменные окружения ──
# Скопируйте в .env.local и заполните. Без них проект работает в dev-режиме:
# встроенный Postgres (PGlite), SMS-код печатается на экран, оплата симулируется.

# База данных (прод). Если пусто — используется встроенный PGlite (.pglite/).
# Пример (Neon/Supabase/свой Postgres):
# DATABASE_URL=postgres://user:password@host:5432/floby

# Подтверждение номера — каналы по приоритету:
#   1) Telegram Gateway (если у номера есть Telegram) → 2) звонок (Zvonok) →
#   3) SMS Aero → 4) SMS (SMSC) → dev.
# Достаточно настроить нужные. Без них код показывается в модалке (только dev).

# 1) Telegram Gateway — код в Telegram по номеру (gateway.telegram.org). Без ИП.
# TELEGRAM_GATEWAY_TOKEN=ваш_токен

# 2) Zvonok flash-call — робот звонит, код = последние цифры номера. Без ИП.
#    В кабинете zvonok.com создать кампанию «Подтверждение звонком» (Flash Call).
# ZVONOK_PUBLIC_KEY=ваш_public_key
# ZVONOK_CAMPAIGN_ID=id_кампании

# 3) SMS Aero — знак «SMS Aero» без подтверждения компании (подходит самозанятому).
# SMSAERO_EMAIL=ваш_email
# SMSAERO_API_KEY=ваш_api_key
# SMSAERO_SIGN=          # свой знак отправителя (если согласован); иначе «SMS Aero»

# 4) SMS (SMSC.ru) — требует договор с ИП/юрлицом.
# SMSC_LOGIN=ваш_логин
# SMSC_PASSWORD=ваш_пароль
# SMSC_SENDER=          # имя отправителя (если согласовано в SMSC)

# Оплата (ЮKassa). Без них card-оплата симулируется (test). Тестовые ключи
# берутся бесплатно в личном кабинете ЮKassa (для самозанятых доступно).
# YOOKASSA_SHOP_ID=ваш_shopId
# YOOKASSA_SECRET_KEY=ваш_секретный_ключ
# Webhook в настройках ЮKassa указать на: https://ВАШ_ДОМЕН/api/payments/webhook

# Админ-доступ: телефоны, которым при входе по SMS выдаётся роль «Админ» (через запятую)
# ADMIN_PHONES=+79281234567
# Админ-доступ для входа через соцсети (VK/Яндекс): email'ы через запятую
# ADMIN_EMAILS=madnatec1@yandex.ru

# Уведомления владельцу о новых заявках в Telegram + бот заказа услуг.
# Бот: @BotFather -> /newbot -> токен. chat_id: напишите боту @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Секрет вебхука Telegram (передаётся в setWebhook как secret_token):
# TELEGRAM_WEBHOOK_SECRET=любая_случайная_строка

# Бот заказа услуг в MAX (мессенджер). Токен: dev.max.ru -> создать бота.
# Вебхук регистрируется на URL https://floby.ru/api/bot/max?secret=<MAX_WEBHOOK_SECRET>
# MAX_BOT_TOKEN=...
# MAX_WEBHOOK_SECRET=любая_случайная_строка

# Хранилище фото «до/после» (Vercel Blob). Без токена в dev фото пишутся в
# public/uploads/ (локально). В проде для загрузки фото токен обязателен:
# Vercel → Storage → Create Blob store → скопировать READ_WRITE токен.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Вход через соцсети (VK ID / Яндекс ID). Флоу полностью клиентский —
# секретные ключи не нужны, только публичные ID. Без них кнопки скрыты.
# VK: https://id.vk.com/business → создать приложение → App ID (число).
#   Redirect URL приложения: https://floby.ru/auth/callback
# NEXT_PUBLIC_VK_CLIENT_ID=53000000
# Яндекс: https://oauth.yandex.ru → создать приложение (веб-сервисы),
#   права «Доступ к email» и «Доступ к аватару». Redirect URI:
#   https://floby.ru/auth/callback?provider=yandex  (и localhost для dev)
# NEXT_PUBLIC_YANDEX_CLIENT_ID=xxxxxxxxxxxxxxxx
